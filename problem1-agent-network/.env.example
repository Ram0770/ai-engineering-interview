# Database Configuration (SQLite local by default, PostgreSQL + pgvector supported)
AGENT_NET_DATABASE_URL=sqlite+aiosqlite:///agent_network.db
# For PostgreSQL:
# AGENT_NET_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_network

# Embedder backend: "sentence-transformers" (local real MiniLM), "openai", or "mock" (offline fast test)
AGENT_NET_EMBEDDER_TYPE=sentence-transformers
AGENT_NET_SENTENCE_MODEL=all-MiniLM-L6-v2

# Optional OpenAI Embedder
# AGENT_NET_EMBEDDER_TYPE=openai
# AGENT_NET_OPENAI_API_KEY=sk-...
# AGENT_NET_OPENAI_MODEL=text-embedding-3-small

# Routing Thresholds & Calibrations
AGENT_NET_SIMILARITY_THRESHOLD=0.75
AGENT_NET_TOP_K_CANDIDATES=20
AGENT_NET_EXPLORATION_RATE=0.15

# Security & Webhook SSRF Protections
AGENT_NET_ALLOW_LOCALHOST_WEBHOOKS=true
AGENT_NET_MAX_WEBHOOK_TIMEOUT_SECONDS=5.0
AGENT_NET_MAX_WEBHOOK_RETRIES=3
AGENT_NET_MAX_PAYLOAD_BYTES=1048576

# Service Configuration
AGENT_NET_HOST=0.0.0.0
AGENT_NET_PORT=8000
