# Hardware Assistant Configuration
# LLM Backend: "ollama" (default local), "openai", "anthropic", or "mock" (for tests)
HW_BACKEND=ollama

# Ollama local settings (100% on-device, zero outbound network egress)
HW_OLLAMA_BASE_URL=http://localhost:11434
HW_OLLAMA_MODEL=llama3.2:3b

# Optional Cloud Backends (Warning: hardware telemetry leaves the machine if configured)
# HW_BACKEND=openai
# HW_OPENAI_API_KEY=sk-...
# HW_OPENAI_MODEL=gpt-4o-mini

# HW_BACKEND=anthropic
# HW_ANTHROPIC_API_KEY=sk-ant-...
# HW_ANTHROPIC_MODEL=claude-3-haiku-20240307

# Execution Safety Limits
HW_EXECUTION_TIMEOUT_SECONDS=5.0
HW_MAX_OUTPUT_BYTES=1048576
HW_ALLOW_SUDO=true

# Cache TTL Configuration
HW_STATIC_CACHE_TTL_SECONDS=3600
HW_DYNAMIC_CACHE_TTL_SECONDS=5

# Audit Logging
HW_AUDIT_LOG_PATH=audit.log

